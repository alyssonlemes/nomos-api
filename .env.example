# Copie este arquivo para .env e configure suas variáveis

# ========== API Configuration ==========
PROJECT_NAME=Nomos API
VERSION=1.0.0
DESCRIPTION=API REST com arquitetura escalável e autenticação JWT
API_V1_PREFIX=/api/v1

# ========== Security ==========
# Chave secreta para JWT (gere uma chave forte e aleatória)
# Para gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua-chave-secreta-super-segura-mude-isso
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== Database (Neon) ==========
# Use a connection string pooled do Neon (host com -pooler) e sslmode=require.
# Não crie Postgres no Render — o banco continua no Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ========== DataJud ==========
DATAJUD_API_KEY=coloque_sua_api_key_aqui

# ========== CORS / Frontend ==========
# URL pública do front no Render (sem barra no final)
FRONTEND_URL=https://nomos-web.onrender.com
# Lista extra de origens: JSON ou separada por vírgula
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional: regex extra. O padrão já libera https://*.onrender.com
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.onrender\.com
